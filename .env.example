# Copy to .env and fill in your values. This file holds SECRETS only — the
# candidate profile, comp bars, target titles/locations, and company seed
# list live in profile.yaml (copy profile.example.yaml to profile.yaml).
#
# For the deployed GitHub Actions workflow these all live as repo secrets
# instead, plus PROFILE_YAML_B64 (= base64 -i profile.yaml) — see the
# "Scheduling" section of README.md.
#
# Provider API keys keep their standard names (the provider SDKs read them
# directly); agent-specific settings use the AGENT_ prefix to avoid clashing
# with generic shell variables like MODEL.

# Required — this project uses Gemini for both scoring and company research
GOOGLE_API_KEY=your_google_api_key_here

# Model selection
AGENT_MODEL=google:gemini-3.1-flash-lite

# Judge model for LLM-as-judge evals (evals/test_llm_judge.py). Deliberately
# a different, more capable tier than AGENT_MODEL, not just a different
# provider — this project has no Anthropic/OpenAI key configured, so the
# judge stays on Google too.
AGENT_JUDGE_MODEL=google:gemini-3.1-pro-preview

# Tavily search, for per-company research (PTO, stability, RTO reality, dealbreaker screening)
TAVILY_API_KEY=your_tavily_api_key_here

# Adzuna jobs API — requires both, separate credentials
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_API_KEY=your_adzuna_api_key_here

# Postmark email delivery — sender/recipient for the daily digest
POSTMARK_SERVER_TOKEN=your_postmark_server_token_here
AGENT_EMAIL_FROM=your_verified_sender@example.com
AGENT_EMAIL_TO=you@example.com

# Logfire observability (optional — console output used if not set)
# LOGFIRE_TOKEN=your_logfire_token_here

# Logging level (DEBUG, INFO, WARNING, ERROR)
AGENT_LOG_LEVEL=INFO
